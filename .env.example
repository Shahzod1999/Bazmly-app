# Backend
EXPO_PUBLIC_API_BASE_URL=https://bazmly-backend-production.up.railway.app

# Push token turi: expo (Expo Push API) yoki native (FCM/APNs)
EXPO_PUBLIC_PUSH_TOKEN_KIND=expo

# Google Maps (Google Cloud Console → Maps SDK for iOS / Android)
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=

# Ilova identifikatori va deep link domeni
APP_BUNDLE_ID=uz.bazmly.app
APP_DOMAIN=bazmly.uz
EXPO_PUBLIC_APP_DOMAIN=bazmly.uz

# EAS (eas init dan keyin)
EAS_PROJECT_ID=

# development | preview | production
APP_VARIANT=development

# Backend smoke test (npm run smoke) — faqat sizning kompyuteringizda ishlatiladi, ilovaga kirmaydi
# SMOKE_API_BASE_URL=            # bo'sh bo'lsa EXPO_PUBLIC_API_BASE_URL
SMOKE_PHONE=
SMOKE_PASSWORD=
SMOKE_STAFF_LOGIN=
SMOKE_STAFF_PASSWORD=
SMOKE_VENUE_ID=
# 1 — bron yaratib darhol bekor qiladi (SMOKE_VENUE_ID majburiy, faqat test venue bilan!)
SMOKE_WRITE=0
