@@ -0,0 +1,111 @@
+"""Staff-facing side of "Xabar yozish": the branch reads and answers its guests.
+
+Every route names its branch with `venue_id`. Reads are guarded by membership —
+the caller must work at that branch, or own its chain; replying needs
+`bookings.confirm`, the slug of everyone who deals with guests. A thread is reachable only
+through the branch it was opened with, so a member of one branch cannot read
+another branch's threads by guessing ids.
+"""
+
+from collections.abc import Sequence
+from typing import Annotated
+
+from fastapi import APIRouter, BackgroundTasks, Path, Query, status
+
+from app.core.dependencies import PaginationDep, SessionDep, VenueMember, require_permission
+from app.modules.auth.schemas import UserRead
+from app.modules.engagement.enums import MessageSenderType
+from app.modules.engagement.schemas import ConversationListItem, MessageCreate, MessageRead
+from app.modules.engagement.services import ConversationService
+from app.modules.engagement.services.delivery import deliver
+from app.modules.venues.repositories import VenueRepository
+
+router = APIRouter(prefix="/v1/venue/conversations", tags=["venue:engagement"])
+
+
+@router.get(
+    "",
+    response_model=list[ConversationListItem],
+    operation_id="venue_conversations_list",
+    summary="Mijozlar bilan suhbatlar",
+    description=(
+        "Filialga yozilgan suhbatlar: mijoz ismi, oxirgi xabar va muassasa hali "
+        "o'qimagan xabarlar soni bilan."
+    ),
+)
+async def list_conversations(
+    user: VenueMember,
+    session: SessionDep,
+    venue_id: Annotated[int, Query(ge=1)],
+) -> Sequence[ConversationListItem]:
+    return await ConversationService(session).list_for_venue(venue_id)
+
+
+@router.get(
+    "/{conversation_id}/messages",
+    response_model=list[MessageRead],
+    operation_id="venue_conversations_messages",
+    summary="Suhbat tarixi",
+    description="Eng yangisidan boshlab, sahifalab.",
+)
+async def list_messages(
+    user: VenueMember,
+    session: SessionDep,
+    pagination: PaginationDep,
+    conversation_id: Annotated[int, Path(ge=1)],
+    venue_id: Annotated[int, Query(ge=1)],
+) -> Sequence[MessageRead]:
+    return await ConversationService(session).venue_history(
+        conversation_id, venue_id, pagination.limit, pagination.offset
+    )
+
+
+@router.post(
+    "/{conversation_id}/messages",
+    response_model=MessageRead,
+    status_code=status.HTTP_201_CREATED,
+    operation_id="venue_conversations_send",
+    summary="Mijozga javob yozish",
+    description="Xabar muassasa nomidan yuboriladi (`sender_type=venue`).",
+)
+async def send_message(
+    payload: MessageCreate,
+    user: Annotated[UserRead, require_permission("bookings.confirm")],
+    session: SessionDep,
+    conversation_id: Annotated[int, Path(ge=1)],
+    venue_id: Annotated[int, Query(ge=1)],
+    background: BackgroundTasks,
+) -> MessageRead:
+    service = ConversationService(session)
+    message = await service.send(
+        conversation_id, user.id, MessageSenderType.VENUE, payload, venue_id=venue_id
+    )
+    conversation = await service.conversations.get_by_id(conversation_id)
+    venue = await VenueRepository(session).get_by_id(venue_id)
+    if conversation is not None:
+        background.add_task(
+            deliver,
+            [conversation.user_id],
+            "message",
+            venue.name if venue is not None else "Muassasa",
+            payload.body[:140],
+            {"conversation_id": conversation_id, "venue_id": venue_id},
+            store=False,
+        )
+    return message
+
+
+@router.post(
+    "/{conversation_id}/read",
+    response_model=list[int],
+    operation_id="venue_conversations_mark_read",
+    summary="Mijoz xabarlarini o'qilgan deb belgilash",
+    description="Faqat mijoz yozgan xabarlar belgilanadi.",
+)
+async def mark_read(
+    user: Annotated[UserRead, require_permission("bookings.confirm")],
+    session: SessionDep,
+    conversation_id: Annotated[int, Path(ge=1)],
+    venue_id: Annotated[int, Query(ge=1)],
+) -> Sequence[int]:
+    return await ConversationService(session).venue_mark_read(conversation_id, venue_id)
