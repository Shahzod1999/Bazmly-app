+def configure_push_sender() -> None:
+    """Called once at startup: picks the provider from settings."""
+    from app.core.config import PushProvider, settings
+
+    if settings.push.provider == PushProvider.EXPO:
+        set_push_sender(ExpoPushSender(settings.push.expo_url, settings.push.expo_access_token))
+        logger.info("Push provider: Expo")
