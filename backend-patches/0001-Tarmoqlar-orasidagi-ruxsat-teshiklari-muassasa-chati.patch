+async def make_group_staff(
+    session: AsyncSession, group: VenueGroup, role_slug: str = "owner"
+) -> VenueStaff:
+    """A group-scoped employment, the way a real owner is stored: `venue_id IS NULL`.
+
+    `make_staff` pins every row to a branch, which is how a test of "another
+    chain's owner" once passed while a real owner — with no branch on the row —
+    held permissions at every branch of every chain."""
+    user = await make_user(session, role=UserRole.VENUE_OWNER)
+    role = await get_staff_role(session, role_slug)
+    staff = VenueStaff(
+        venue_group_id=group.id,
+        venue_id=None,
+        user_id=user.id,
+        staff_role_id=role.id,
+        role_scope=role.scope,
+        is_active=True,
+        invited_at=datetime.now(UTC).replace(tzinfo=None),
+    )
+    session.add(staff)
+    await session.flush()
+    return staff
