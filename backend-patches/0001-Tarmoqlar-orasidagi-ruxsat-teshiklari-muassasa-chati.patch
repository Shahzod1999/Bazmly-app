diff --git a/app/modules/engagement/services/delivery.py b/app/modules/engagement/services/delivery.py
new file mode 100644
index 0000000..9befc67
--- /dev/null
+++ b/app/modules/engagement/services/delivery.py
@@ -0,0 +1,92 @@
+"""Notifications that leave the request: an in-app row plus a push, after commit.
+
+Every event here runs as a background task on its own session, after the response
+is sent. The request's session is closed by then, and a failure — a dead token, a
+provider timeout — must never undo what the request already committed. So each
+recipient is attempted on its own and failures are logged, never raised.
+
+TODO(queue): `BackgroundTasks` runs in the web worker, so a restart loses anything
+in flight. Replace with `arq` or Celery before production — recorded in
+DECISIONS.md.
+"""
+
+import logging
+from collections.abc import Iterable
+from typing import Any
+
+from fastapi import BackgroundTasks
+
+logger = logging.getLogger("app.notifications")
+
+
+async def deliver(
+    user_ids: Iterable[int],
+    notification_type: str,
+    title: str,
+    body: str,
+    data: dict[str, Any] | None = None,
+    *,
+    store: bool = True,
+    skip_user_id: int | None = None,
+) -> None:
+    from app.core.database.db_helper import db_helper
+    from app.modules.engagement.services.notification_service import NotificationService
+
+    payload = {"type": notification_type, **(data or {})}
+    for user_id in dict.fromkeys(user_ids):
+        if user_id == skip_user_id:
+            continue
+        try:
+            async with db_helper.session_factory() as session:
+                service = NotificationService(session)
+                if store:
+                    await service.notify_in_transaction(
+                        user_id=user_id,
+                        notification_type=notification_type,
+                        title=title,
+                        body=body,
+                        payload=payload,
+                    )
+                    await session.commit()
+                await service.push_after_commit(user_id, title, body, payload)
+        except Exception:
+            logger.warning(
+                "%s delivery failed for user_id=%s", notification_type, user_id, exc_info=True
+            )
+
+
+async def deliver_to_venue_staff(
+    venue_id: int,
+    permission_slug: str,
+    notification_type: str,
+    title: str,
+    body: str,
+    data: dict[str, Any] | None = None,
+    *,
+    store: bool = True,
+    skip_user_id: int | None = None,
+) -> None:
+    from app.core.database.db_helper import db_helper
+    from app.modules.staff.repositories import VenueStaffRepository
+
+    try:
+        async with db_helper.session_factory() as session:
+            user_ids = await VenueStaffRepository(session).user_ids_with_permission(
+                venue_id, permission_slug
+            )
+    except Exception:
+        logger.warning("staff lookup failed for venue_id=%s", venue_id, exc_info=True)
+        return
+    await deliver(
+        user_ids,
+        notification_type,
+        title,
+        body,
+        data,
+        store=store,
+        skip_user_id=skip_user_id,
+    )
+
+
+def queue(background: BackgroundTasks, func: Any, *args: Any, **kwargs: Any) -> None:
+    background.add_task(func, *args, **kwargs)
