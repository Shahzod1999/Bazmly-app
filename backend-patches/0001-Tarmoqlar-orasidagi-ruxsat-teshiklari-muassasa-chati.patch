+"""The Expo sender: what it sends, and what it refuses to send."""
+
+import json
+
+import httpx
+
+from app.core.transports import ExpoPushSender
+
+
+async def test_sends_expo_tokens_with_data_and_skips_the_rest() -> None:
+    seen: list[list[dict]] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen.append(json.loads(request.content))
+        return httpx.Response(200, json={"data": [{"status": "ok"}]})
+
+    sender = ExpoPushSender(
+        "https://push.test/send", access_token="t0k", transport=httpx.MockTransport(handler)
+    )
+    await sender.send(
+        ["ExponentPushToken[abc]", "fcm-native-token", "ExponentPushToken[abc]"],
+        "Bron tasdiqlandi",
+        "Bahor — 24.10, 19:00",
+        {"type": "booking_confirmed", "booking_id": 7},
+    )
+
+    [batch] = seen
+    assert [m["to"] for m in batch] == ["ExponentPushToken[abc]"]
+    assert batch[0]["data"] == {"type": "booking_confirmed", "booking_id": 7}
+    assert batch[0]["channelId"] == "bookings"
+
+
+async def test_nothing_to_send_makes_no_request() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:  # pragma: no cover
+        raise AssertionError("no request expected")
+
+    sender = ExpoPushSender("https://push.test/send", transport=httpx.MockTransport(handler))
+    await sender.send(["native-only"], "t", "b")
+
+
+async def test_a_provider_failure_is_swallowed() -> None:
+    sender = ExpoPushSender(
+        "https://push.test/send",
+        transport=httpx.MockTransport(lambda request: httpx.Response(503)),
+    )
+    await sender.send(["ExponentPushToken[x]"], "t", "b")
