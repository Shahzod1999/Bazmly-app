+def _as_id(raw: object, name: str) -> int:
+    """A path or query id, read before FastAPI has validated it — so a malformed
+    one (`/groups/undefined/...`) is a 422, never a 500."""
+    try:
+        value = int(str(raw))
+    except ValueError:
+        raise ValidationFailedError(f"`{name}` butun son bo'lishi kerak") from None
+    if value < 1:
+        raise ValidationFailedError(f"`{name}` musbat bo'lishi kerak")
+    return value
+
+
+class VenueMemberRequired:
+    """Guards a partner *read*: the caller must work at the branch it names.
+
+    The writes carry a permission slug each; the reads used to carry nothing, so
+    any signed-in user could list another venue's bookings — guest names and
+    phone numbers included — by putting its id in the URL. Membership is the
+    right bar for a read: a waiter sees the day's bookings without holding
+    `bookings.confirm`.
+
+    `venue_id` comes from the path when the route is nested under a branch, and
+    from the query otherwise — the same rule as `PermissionRequired`.
+    """
+
+    async def __call__(
+        self,
+        request: Request,
+        session: SessionDep,
+        user: CurrentUser,
+        venue_id_query: Annotated[int | None, Query(alias="venue_id")] = None,
+    ) -> UserRead:
+        if auth_disabled():
+            return user
+        raw = request.path_params.get("venue_id", venue_id_query)
+        if raw is None:
+            raise ValidationFailedError("Bu so'rov uchun `venue_id` talab qilinadi")
+        await StaffService(session).require_membership(user.id, _as_id(raw, "venue_id"))
+        return user
+
+
+class GroupMemberRequired:
+    """`VenueMemberRequired` for a chain: `group_id` from the path or the query."""
+
+    async def __call__(
+        self,
+        request: Request,
+        session: SessionDep,
+        user: CurrentUser,
+        group_id_query: Annotated[int | None, Query(alias="group_id")] = None,
+    ) -> UserRead:
+        if auth_disabled():
+            return user
+        raw = request.path_params.get("group_id", group_id_query)
+        if raw is None:
+            raise ValidationFailedError("Bu so'rov uchun `group_id` talab qilinadi")
+        await StaffService(session).require_group_membership(user.id, _as_id(raw, "group_id"))
+        return user
+
+
+VenueMember = Annotated[UserRead, Depends(VenueMemberRequired())]
+GroupMember = Annotated[UserRead, Depends(GroupMemberRequired())]
+
