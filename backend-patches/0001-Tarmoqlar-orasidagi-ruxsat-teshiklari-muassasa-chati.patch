+"""One chain's people never act on, or read, another chain's branch.
+
+Registering a chain is open to every user, so "is an owner somewhere" is no
+authority at all — every check here is about *which* chain.
+"""
+
+from datetime import time
+
+from httpx import AsyncClient
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from tests.api.conftest import auth_header
+from tests.repositories import factories
+
+
+async def make_chain(session: AsyncSession):
+    group = await factories.make_venue_group(session)
+    venue = await factories.make_venue(session, group=group)
+    await factories.make_working_hours(session, venue, time(8, 0), time(22, 0))
+    return group, venue
+
+
+async def test_an_owner_holds_no_permission_in_another_chain(
+    api_client: AsyncClient, session: AsyncSession
+) -> None:
+    _group, venue = await make_chain(session)
+    other_group, _ = await make_chain(session)
+    outsider = await factories.make_group_staff(session, other_group, role_slug="owner")
+    await factories.grant(session, "owner", "branch.manage", "bookings.confirm")
+
+    edit = await api_client.patch(
+        f"/api/v1/venue/venues/{venue.id}",
+        json={"street": "Yangi ko'cha"},
+        headers=auth_header(outsider.user_id),
+    )
+    confirm = await api_client.post(
+        "/api/v1/venue/bookings/1/confirm",
+        params={"venue_id": venue.id},
+        headers=auth_header(outsider.user_id),
+    )
+
+    assert edit.status_code == 403
+    assert confirm.status_code == 403
+
+
+async def test_an_owner_keeps_every_permission_in_their_own_chain(
+    api_client: AsyncClient, session: AsyncSession
+) -> None:
+    group, venue = await make_chain(session)
+    second = await factories.make_venue(session, group=group)
+    owner = await factories.make_group_staff(session, group, role_slug="owner")
+    await factories.grant(session, "owner", "branch.manage")
+
