+class ExpoPushSender:
+    """Expo push service — the mobile app registers `ExponentPushToken[...]` tokens.
+
+    `data` travels with the push so a tap opens the right screen: `type` plus the
+    id it needs (`booking_id`, `conversation_id`). Tokens of any other shape are
+    skipped rather than sent to a service that would reject the whole batch.
+    """
+
+    BATCH = 100  # Expo accepts up to 100 messages per request.
+
+    def __init__(
+        self,
+        url: str,
+        access_token: str | None = None,
+        timeout: float = 10.0,
+        transport: httpx.AsyncBaseTransport | None = None,
+    ) -> None:
+        self.url = url
+        self.transport = transport
+        self.headers = {"Accept": "application/json", "Content-Type": "application/json"}
+        if access_token:
+            self.headers["Authorization"] = f"Bearer {access_token}"
+        self.timeout = timeout
+
+    @staticmethod
+    def is_expo_token(token: str) -> bool:
+        return token.startswith(("ExponentPushToken[", "ExpoPushToken["))
+
+    async def send(
+        self, tokens: list[str], title: str, body: str, data: dict[str, Any] | None = None
+    ) -> None:
+        messages = [
+            {
+                "to": token,
+                "title": title,
+                "body": body,
+                "data": data or {},
+                "sound": "default",
+                "channelId": "bookings",
+            }
+            for token in dict.fromkeys(tokens)
+            if self.is_expo_token(token)
+        ]
+        if not messages:
+            return
+        async with httpx.AsyncClient(timeout=self.timeout, transport=self.transport) as client:
+            for start in range(0, len(messages), self.BATCH):
+                batch = messages[start : start + self.BATCH]
+                try:
+                    response = await client.post(self.url, json=batch, headers=self.headers)
+                    response.raise_for_status()
+                    tickets = response.json().get("data", [])
+                except httpx.HTTPError, ValueError:
+                    logger.warning("Expo push batch failed", exc_info=True)
+                    continue
+                for message, ticket in zip(batch, tickets, strict=False):
+                    if isinstance(ticket, dict) and ticket.get("status") == "error":
+                        logger.info(
+                            "Expo push rejected for %s: %s",
+                            message["to"][:24],
+                            ticket.get("details") or ticket.get("message"),
+                        )
 
 
 _push_sender: PushSender = LoggingPushSender()
@@ -32,3 +102,12 @@ def get_push_sender() -> PushSender:
 def set_push_sender(sender: PushSender) -> None:
     global _push_sender
     _push_sender = sender
+
